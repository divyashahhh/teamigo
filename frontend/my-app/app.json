{
  "expo": {
    "name": "Teamigo",
    "slug": "teamigo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/image.png",
    "scheme": "teamigo",
    "owner": "divyashahhh",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/image.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.divyashahhh.teamigo",
      "config": {
        "usesNonExemptEncryption": false,
        "googleSignIn": {
          "reservedClientId": "477934222059-6ajo0nt4p6iuo7j1t0ggc3beojamsjhr.apps.googleusercontent.com"
        }
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to show you nearby matches and events.",
        "NSLocationAlwaysUsageDescription": "We need your location to show you nearby matches and events.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Teamigo to use your location to show you nearby matches and events."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "teamigo"
      },
      "BACKEND_URL": "https://teamigo-backend.onrender.com"
    },
    "originalFullName": "@divyashahhh/teamigo"
  }
}